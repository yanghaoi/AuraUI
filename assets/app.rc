// UTF-8 source: without this pragma windres reads the bytes as ANSI/Latin-1
// and the em-dash below shows up as "鈥?" in Explorer's file properties.
#pragma code_page(65001)

#include <windows.h>
#include "core/version.h"  // single source of the version

/* Application icon (multi-size, generated by scripts/make_icon.py) */
1 ICON "icon.ico"

/* Application manifest: PerMonitorV2 DPI awareness + Common Controls v6 */
2 24 "app.manifest"

/* Version information */
1 VERSIONINFO
FILEVERSION     AURAUI_VER_MAJOR, AURAUI_VER_MINOR, AURAUI_VER_PATCH, AURAUI_VER_BUILD
PRODUCTVERSION  AURAUI_VER_MAJOR, AURAUI_VER_MINOR, AURAUI_VER_PATCH, AURAUI_VER_BUILD
FILEOS          0x00000004L
FILETYPE        0x00000001L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "AuraUI"
            VALUE "FileDescription",  "AuraUI — Ambient Desktop Monitor"
            VALUE "FileVersion",      AURAUI_VER_STRING
            VALUE "InternalName",     "AuraUI"
            VALUE "LegalCopyright",   "Copyright (c) 2026 YangHao. MIT License."
            VALUE "OriginalFilename", "AuraUI.exe"
            VALUE "ProductName",      "AuraUI · Ambient Desktop Monitor"
            VALUE "ProductVersion",   AURAUI_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
